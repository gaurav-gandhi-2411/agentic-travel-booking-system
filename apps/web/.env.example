# Backend API (server-side only — never exposed to the browser)
# Points to the FastAPI server running locally or on Cloud Run
API_BASE_URL=http://localhost:8000

# Secret key checked against X-API-Key header on the FastAPI side
# Must match DEMO_API_KEY in apps/api/.env (only enforced when APP_MODE=demo)
DEMO_API_KEY=change-me-before-demo

# Legacy public URL (unused in demo path — kept for future use)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Clerk (frontend auth — Phase 8)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
