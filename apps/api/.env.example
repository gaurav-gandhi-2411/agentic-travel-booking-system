# LLM routing (default: local — uses Ollama on localhost:11434)
# Options: local | free | demo | demo-haiku | demo-free | prod | eval
# prod/eval/demo/demo-haiku require ANTHROPIC_API_KEY.
# demo-free requires GROQ_API_KEY (free tier via console.groq.com).
# Per-request overrides via X-LLM-Profile header (demo-haiku | demo-free).
LLM_ROUTING_PROFILE=local

# Optional: override path to llm_routing.yaml (rarely needed)
# LLM_ROUTING_CONFIG_PATH=/path/to/llm_routing.yaml

# Anthropic — required when LLM_ROUTING_PROFILE=prod or eval
ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenRouter — required when LLM_ROUTING_PROFILE=free
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_SITE_URL=https://your-site.example.com
OPENROUTER_APP_NAME=DealHunter

# Groq — required for demo-free profile (X-LLM-Profile: demo-free)
# Free API key: https://console.groq.com → API Keys → Create API Key
GROQ_API_KEY=your-groq-api-key

# Aviasales / Travelpayouts Data API
# API key: https://www.travelpayouts.com/developers/api
AVIASALES_API_KEY=your-aviasales-api-key
# Affiliate partner ID: https://www.travelpayouts.com/programs
AVIASALES_PARTNER_ID=your-partner-id

# Demo mode
# APP_MODE=synthetic  — uses SyntheticProvider, no real API calls (default, tests)
# APP_MODE=demo       — uses AviasalesAdapter with real key; enforces auth
APP_MODE=synthetic

# Single API key for the demo frontend (only checked when APP_MODE=demo)
DEMO_API_KEY=change-me-before-demo

# Ollama — optional override (default: http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# vLLM — optional self-hosted serving (default: http://localhost:8000)
# VLLM_BASE_URL=http://localhost:8000
# VLLM_API_KEY=EMPTY

# Database (Neon Postgres)
DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb

# Cache + Rate Limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# GCP
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# App
APP_ENV=development
SECRET_KEY=change-me-in-production
ALLOWED_ORIGINS=http://localhost:3000

# Sentry (optional — leave blank to disable)
SENTRY_DSN=
