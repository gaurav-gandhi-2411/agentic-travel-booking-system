# Default: normalize line endings to LF on commit, LF on checkout
* text=auto eol=lf

# Windows-native scripts need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Explicitly text files (belt-and-suspenders for editors that don't respect eol=lf)
*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.sh    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.sql   text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf

# Binary — never touch line endings
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.tar   binary
*.gz    binary
*.whl   binary
*.pyc   binary
